{
  "name": "bookkeeper",
  "productName": "BookKeeper",
  "version": "0.3.0",
  "description": "Offline bulk transaction entry with Excel and Word output",
  "author": "soumaghosh827",
  "repository": {
    "type": "git",
    "url": "https://github.com/soumaghosh827/bookkeeper.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
